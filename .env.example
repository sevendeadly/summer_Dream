# ===========================
# ENVIRONMENT VARIABLES TEMPLATE
# ===========================
# Copy this file to .env and fill in your actual values
# NEVER commit .env to git - it contains sensitive information

# ===========================
# Brevo Email Configuration
# ===========================
# Get API Key from: https://app.brevo.com/settings/keys/api
# Verify sender email/domain in Brevo before production sends
BREVO_API_KEY=xkeysib-your-api-key-here
BREVO_FROM_EMAIL=noreply@yourwedding.com

# Admin email (where admin notifications go)
ADMIN_EMAIL=your-email@example.com

# ===========================
# Notion Configuration
# ===========================
# Get API Key from: https://notion.so → Settings & members → Integrations → Create new integration
# Database ID from your Notion database sharing link
NOTION_API_KEY=secret_your_notion_key_here
NOTION_DATABASE_ID=your_database_id_here

# ===========================
# Admin Dashboard Security
# ===========================
# Create a strong password for admin authentication
# This is required to access the admin dashboard
ADMIN_SECRET=your-secure-admin-password-here-change-this

# ===========================
# IMPORTANT SECURITY NOTES
# ===========================
# 1. NEVER commit .env to git
# 2. Add .env to .gitignore (should be there already)
# 3. Keep API keys confidential
# 4. Rotate keys if compromised
# 5. Use different keys for dev and production
# 6. Store Netlify env vars in Netlify Dashboard, not here

# ===========================
# LOCAL DEVELOPMENT
# ===========================
# To test locally:
# 1. Fill in real values above
# 2. Run: netlify dev
# 3. Functions will use these env vars
# 4. Test RSVP form and admin dashboard

# ===========================
# PRODUCTION DEPLOYMENT (Netlify)
# ===========================
# Set environment variables in Netlify Dashboard:
# Site settings → Environment variables
# Add all variables above (except ADMIN_SECRET if not needed locally)
# Netlify will use these for deployed functions

# ===========================
# Brevo Free Tier Info
# ===========================
# - 300 emails per day
# - No credit card required for basic transactional sending
# - Great for testing and low-volume events
# - Upgrade if you need higher volume or advanced features
